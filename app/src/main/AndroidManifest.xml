<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Интернет: синхронизация с Google Calendar API / Яндекс -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Уведомления о напоминаниях (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Точные будильники для напоминаний (Android 12+; на 14+ выдаётся пользователем) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Полноэкранные уведомления-напоминания поверх локскрина (Android 9+) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Запись голосовых заметок -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Системный календарь: используется синхронизацией при наличии аккаунта -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Перезапуск напоминаний после перезагрузки устройства -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MyCalendarApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyCalendar">

        <!-- Единственная Activity приложения: навигация целиком на Compose -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyCalendar.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link для возврата OAuth-токена Яндекс ID: mycalendar://oauth#access_token=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="mycalendar" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- Восстановление напоминаний после перезагрузки устройства -->
        <receiver
            android:name=".work.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Срабатывание напоминаний по точным будильникам -->
        <receiver
            android:name=".notifications.AlarmReceiver"
            android:exported="false" />

        <!-- Кнопка «Отложить на 10 мин» в уведомлении -->
        <receiver
            android:name=".notifications.SnoozeReceiver"
            android:exported="false" />

        <!-- Полноэкранный аларм-экран: поверх локскрина, включает погашенный экран -->
        <activity
            android:name=".notifications.ReminderActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:theme="@style/Theme.MyCalendar.Alarm"
            android:turnScreenOn="true" />

        <!-- Отключаем автозапуск WorkManager: Configuration.Provider с HiltWorkerFactory -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
    </application>
</manifest>
